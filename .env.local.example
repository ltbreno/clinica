# Sem essas variáveis, o app usa um armazenamento em memória (só para dev local).
# Configure a integração de Redis (Upstash) no Vercel Marketplace e cole as
# variáveis que ela gera aqui, ou rode `vercel env pull` depois de conectar.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Também aceita uma connection string padrão (Redis Cloud e similares).
REDIS_URL=

# Voz da locução na TV. Sem nenhuma dessas variáveis, a locução simplesmente
# não é gerada (o bipe continua funcionando normalmente).

# ElevenLabs (elevenlabs.io > Profile > API Keys) — grátis, sem cartão,
# 10.000 caracteres/mês. Tem prioridade sobre o Google TTS se ambos
# estiverem configurados.
ELEVENLABS_API_KEY=
# Opcional: troca a voz padrão (Rachel). Veja outras em elevenlabs.io/voice-library.
ELEVENLABS_VOICE_ID=

# Alternativa: Google Cloud Text-to-Speech (console.cloud.google.com > APIs
# e serviços > Credenciais, com a "Cloud Text-to-Speech API" ativada).
# Exige conta com cartão cadastrado, mas tem cota gratuita bem maior.
GOOGLE_TTS_API_KEY=
