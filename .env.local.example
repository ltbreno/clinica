# Sem essas variáveis, o app usa um armazenamento em memória (só para dev local).
# Configure a integração de Redis (Upstash) no Vercel Marketplace e cole as
# variáveis que ela gera aqui, ou rode `vercel env pull` depois de conectar.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Também aceita uma connection string padrão (Redis Cloud e similares).
REDIS_URL=

# API key do Google Cloud Text-to-Speech (console.cloud.google.com > APIs
# e serviços > Credenciais, com a "Cloud Text-to-Speech API" ativada).
# Sem essa variável, a locução na TV simplesmente não é gerada (o bipe
# continua funcionando normalmente).
GOOGLE_TTS_API_KEY=
